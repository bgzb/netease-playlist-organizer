{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "panel/**/*.ts",
    "tests/**/*.ts",
    "scripts/verify-read-entry.ts"
  ]
}
